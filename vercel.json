{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "resume.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "resume.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "resume.js", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "admin.js", "use": "@vercel/static" },
    { "src": "admin-dashboard.css", "use": "@vercel/static" },
    { "src": "mediaStorageService.js", "use": "@vercel/static" },
    { "src": "data.json", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "api/auth/*.js", "use": "@vercel/node" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/auth/$1.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/admin/?", "dest": "/admin.html" },
    { "src": "/resume/?", "dest": "/resume.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
